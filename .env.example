# Copy to .env.local and fill in. Never commit real values.
# Both values are public client settings: the anon key only works through Row Level Security.
# NEVER put the service_role key in an EXPO_PUBLIC_ variable (it would ship inside the app).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
