{
  "expo": {
    "name": "Forest Pomodoro",
    "slug": "forest-pomodoro",
    "description": "A calm Pomodoro focus timer: every focus session grows a tree in your forest.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pomodoroapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.asametduran.pomodoroforest",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.asametduran.pomodoroforest",
      "adaptiveIcon": {
        "backgroundColor": "#F4E9D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Forest Pomodoro",
      "shortName": "Pomodoro",
      "themeColor": "#F9F1E6",
      "backgroundColor": "#F9F1E6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F1E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#212820",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
